OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTORSTORE_PATH=./vectorstore
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4
SIMILARITY_THRESHOLD=0.3
CACHE_DIR=./cache
CACHE_TTL=3600
ENABLE_CACHE=true
DOCUMENTS_DIR=./documents
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
